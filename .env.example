#
# Template for a fresh deployment. Copy to .env and fill in the blanks.
# See INSTALL.md for the full install, including the PostgreSQL setup these
# values must match.
#
# Every tenant-level setting (provider, keys, models, brand, timezone) is stored in
# the database and edited in Settings — this file is deployment-level only.
#
#
# Key vars hold no secrets here; generate real values:
#   DB passwords        openssl rand -hex 24
#   APP_ENCRYPTION_KEY  openssl rand -hex 32
#

# ── Database ────────────────────────────────────────────────────────────────
# Two roles, and the split matters: DB_MIGRATOR_USER owns the tables, DB_USER
# only reads and writes them. PostgreSQL exempts a table's owner from its own
# RLS policies, so if one role did both, tenant isolation would be silently
# inert. Production refuses to start unless these are two different roles.
# Both must already exist — INSTALL.md step 1 has the SQL.
DB_HOST=127.0.0.1
DB_PORT=5432
# Any schema name is allowed; the migration templates it, nothing is hardcoded.
DB_SCHEMA=chatbot_schema
DB_NAME=chatbot_assistant
# The application role: DML only, subject to Row-Level Security.
DB_USER=chatbot_user
DB_PASS=
# The owner role: runs the migration. Required in production.
DB_MIGRATOR_USER=chatbot_migrator
DB_MIGRATOR_PASS=

# ── App ──
# development | production
APP_ENV=production
# Absolute base URL: drives email links, Secure cookies and HSTS.
APP_URL=https://chatbot.example.com
# false closes public sign-up.
ALLOW_REGISTRATION=true

# ── Security / limits (deployment-level: these protect the instance, not a tenant) ──
# Escape hatch for the single-role DB model — no database-level tenant isolation.
# Encrypts the MFA TOTP seed. Required in production.
#   generate:  openssl rand -hex 32    (changing it invalidates MFA enrollments)
APP_ENCRYPTION_KEY=
# How many reverse proxies may be trusted for X-Forwarded-For. 0 = none.
TRUSTED_PROXY_HOPS=0
PUBLIC_CHAT_RATE_MAX=120
PUBLIC_CHAT_TOKEN_RATE_MAX=300
PUBLIC_CHAT_RATE_WINDOW=60
# Allow tenant provider URLs to point at loopback/RFC1918 hosts (self-hosted LLM).
ALLOW_PRIVATE_PROVIDER_URLS=false

# ── Storage & sessions ──
STORAGE_DIR=storage/uploads
SESSION_COOKIE_NAME=chatbot_session
SESSION_LIFETIME=1440

# ── Mail (Nodemailer) ──
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USER=
SMTP_PASS=
# starttls | ssl | none
SMTP_ENCRYPTION=starttls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Chatbot Assistant
